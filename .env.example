# Application
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=career_cards
POSTGRES_USER=career_cards
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://career_cards:change-me@postgres:5432/career_cards

# OCR
OCR_PROVIDER=mock
OCR_CLOUD_ALLOWED=false

# Hunyuan local provider (llama.cpp OpenAI-compatible API)
HUNYUAN_OCR_BASE_URL=http://127.0.0.1:8081/v1
HUNYUAN_MODEL_NAME=HYVL
HUNYUAN_REQUEST_TIMEOUT_SECONDS=120

# Extend (optional; never commit real key)
EXTEND_API_KEY=
EXTEND_BASE_URL=
EXTEND_EXTRACTOR_ID=

# Google Sheets
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Responses
GOOGLE_CREDENTIALS_HOST_DIR=./config/google

# Credential strategy is deployment-specific.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google/service-account.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Images
CARD_IMAGE_RETENTION=delete_after_approval
CARD_IMAGE_DIR=/data/card-images

# Capture / vision
AUTO_CAPTURE_ENABLED=false
CARD_STABILITY_MS=750
CARD_MIN_AREA_RATIO=0.20

# Logging
LOG_LEVEL=INFO
